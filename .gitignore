# Root ignore rules for the whole repo. Imported components keep their own, more specific
# .gitignore as well: hardware/estop/ (ESP-IDF sdkconfig holds the Wi-Fi password),
# manipulation/panthera_teleop/ (recorded episodes, vendor SDK checkout), manipulation/panthera_sim/.

# ============================================================================
# Secrets and credentials (never commit)
# ============================================================================
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.netrc
.aws/
.ssh/

# ============================================================================
# Internal / sensitive documents (keep facts in markdown, not the source files)
# ============================================================================
# Emails, vendor correspondence, exported reports, office files, archives
*.pdf
*.PDF
*.eml
# (no *.msg rule: that would also hide ROS message definitions)
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
# Generated duplicate of current_draw/REPORT.md (REPORT.md is the source)
robots/wisco_v1/reports/current_draw/REPORT.html
robots/wisco_v1/reports/current_draw/*.csv
robots/wisco_v1/checks/results/
training/locomotion/wisco_v1/vm/check_env_result.json
ros2_ws/src/wisco_ethercat_ros2_hw/build/

# ============================================================================
# Python environments and caches
# ============================================================================
.venv/
.venv-*/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ============================================================================
# ROS / colcon build output
# ============================================================================
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
build/
install/
log/
*.bag
*.db3
*.mcap

# ============================================================================
# Large regenerable artifacts
# ============================================================================
# Built environment worlds (tools/env_build.py regenerates them): build/, build_wisco/, build_<robot>/
assets/envs/**/build/
assets/envs/**/build_*/
*.mjb
# Manipulation sim build output (1 GB)
training/manipulation/sim/build/
# Training results: checkpoints, motion files, videos (store externally)
# (anchored with / so docs/runs/ worklogs and phase_a/results/ reports stay tracked)
/results/
/runs/
logs/
outputs/
wandb/
training/*/data/
scan_pipeline/**/data/
*.npz
*.mp4
*.mov
*.webm
*.gif
# Hugging Face / dataset caches
.cache/
**/.cache/huggingface/

# Model weights: ignored by default...
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
# ...except the small deployed policies the ROS stack loads (manifest + policy, ~7 MB total)
!models/**/policy.onnx

# ============================================================================
# Logs and OS / editor junk
# ============================================================================
MUJOCO_LOG.TXT
**/MUJOCO_LOG.TXT
*.log
.DS_Store
.vscode/
.idea/
*.swp
.claude/settings.local.json

# docs/academy/build.js also writes a publishing fragment; only index.html (the standalone page) is kept
docs/academy/artifact.html

# Panthera teleop runtime configs, regenerated by app/launch-teleop.py prepare() on every start (machine paths, USB devices)
manipulation/panthera_teleop/config/robot-configs/*.yaml

# Team annotations of private arm recordings (episode trims, labels, review progress); only the template is shared
manipulation/panthera_teleop/config/postprocessing-*.json
!manipulation/panthera_teleop/config/postprocessing-template.json
manipulation/panthera_teleop/config/*.review-state.json
manipulation/panthera_teleop/config/hitl-round*.json

# Retargeted motion clips and their preview renders: derived from LAFAN1 (CC BY-NC-ND, no redistribution of
# derivatives); regenerate with training/tracking/wisco_v1/retarget_lafan1.py and compare_strip.py
training/tracking/*/motions/*.csv
training/tracking/*/motions/*.debug.npz
training/tracking/*/motions/preview/

# Datasets, recordings and other generated data
*.hdf5
*.h5
*.parquet
*.arrow
*.tfrecord*
*.zarr/
*.usd
*.usda
.ipynb_checkpoints/
node_modules/
*.orig
*.rej
*.tmp

# More credential formats
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
service-account*.json

# RK3588 cyclictest output (the summary goes into the hardware README)
infra/rk3588/reports/

# panthera_agent: insertion task scenes the curriculum generates at run time (scenes/catalog.py register)
manipulation/panthera_sim/sim/panthera/agent_ins_*.xml

# Copy to .env (same folder) and fill in. .env is gitignored and never synced to the VMs.
# The ROS container loads it automatically (infra/docker/compose.yaml -> env_file).

# Claude API key for the task planner (hsim_planner). https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# Not needed by anything yet; placeholders for later phases.
# WANDB_API_KEY=      # training logs (the GPU VM keeps its own login in ~/.netrc)
# HF_TOKEN=           # Hugging Face, for LeRobot datasets / VLA weights (Phase 5)

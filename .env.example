# Copy to .env (same folder) and fill in. .env is gitignored and never synced to the GPU machine.
# Everything machine- or account-specific lives here, not in the code: keys, hosts, addresses.
# The ROS container loads it automatically (infra/docker/compose.yaml -> env_file); the scripts that need a
# value source it themselves and stop with a message when it is missing.

# Claude API key for the task planner (hsim_planner). https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# GPU training machine (tools/vm.sh): SSH host alias from ~/.ssh/config, and the repo folder under ~ there.
VM_HOST=hsim-gpu
VM_REPO=robot

# Panthera arm policy inference machine, user@host (manipulation/panthera_teleop: deploy, tunnel, checkpoint audit).
PANTHERA_SSH_HOST=

# Motion capture computer that streams VRPN (OptiTrack Motive, Vicon, ...): host name or IP address
# (wisco_ethercat_ros2_hw mocap.launch.py).
MOCAP_HOST=

# The robot's internal cable between the Jetson and the RK3588 (infra/robot_network/robot_network.sh): each
# computer's address on it, the prefix length, and the ROS 2 domain the robot's stack uses.
ROBOT_JETSON_IP=
ROBOT_RK3588_IP=
ROBOT_LINK_PREFIX=24
ROBOT_ROS_DOMAIN_ID=42

# Hugging Face namespace (account or org) that dataset tools publish to and docs refer to as $HF_NAMESPACE.
HF_NAMESPACE=

# Optional: only when a tool asks for them.
# WANDB_API_KEY=      # training logs (the GPU machine keeps its own login in ~/.netrc)
# HF_TOKEN=           # Hugging Face, for pushing LeRobot datasets and downloading gated weights

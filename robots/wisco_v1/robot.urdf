  <link name="imu_link" />
  <!-- IMU: EVAL_HI05 board on the 'IMU Mount', back of the pelvis, chip facing backward (Legs V2 CAD). Frame axes = board axes: x -> robot right, y -> down, z -> forward. Still to check: the board's printed axes match the CAD part. -->
  <joint name="imu_link_fixed" type="fixed">
    <parent link="pelvis" />
    <child link="imu_link" />
    <origin xyz="-0.051791 -0.000257852 0.0345015" rpy="-1.5707963268 0.0000000000 -1.5707963268" />
  </joint>
  <link name="head_camera" />
  <joint name="head_camera_fixed" type="fixed">
    <parent link="head" />
    <child link="head_camera" />
    <origin xyz="0.0847853 -4.88679e-06 0.0152735" rpy="0 0 0" />
  </joint>
  <!-- ZED X stereo camera (HARDWARE_ISSUES H8). Mount tilt not yet confirmed: assumed level. head_camera: x forward, y left, z up. head_camera_optical: ROS optical convention (z forward, x right, y down). -->
  <link name="head_camera_optical" />
  <joint name="head_camera_optical_fixed" type="fixed">
    <parent link="head_camera" />
    <child link="head_camera_optical" />
    <origin xyz="0 0 0" rpy="-1.5707963268 0.0000000000 -1.5707963268" />
  </joint>
  <link name="left_sole" />
  <joint name="left_sole_fixed" type="fixed">
    <parent link="left_ankle_roll_link" />
    <child link="left_sole" />
    <origin xyz="0.0501587 0.000141269 -0.044028" rpy="0 0 0" />
  </joint>
  <link name="right_sole" />
  <joint name="right_sole_fixed" type="fixed">
    <parent link="right_ankle_roll_link" />
    <child link="right_sole" />
    <origin xyz="0.0498413 0.000141267 -0.0439721" rpy="0 0 0" />
  </joint>
  <!-- Transmissions: one MyActuator RMD-X motor per joint, except the ankles (2x X4-36) and waist roll/pitch (2x X6-60), which are rod linkages: their joint effort/velocity above are linkage equivalents at the zero pose; per-motor conversion: robots/wisco_v1/model/ankle_motor.py (ankles), robots/wisco_v1/linkage.py (both). -->
  <transmission name="left_hip_pitch_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_pitch">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_pitch_motor">
      <mechanicalReduction>19.612</mechanicalReduction>
    </actuator>
    <!-- MyActuator RMD-X8-150 | control: EtherCAT mode 5 (PVT/MIT impedance): position target + kp/kd per cycle, PD on the driver -->
  </transmission>
  <transmission name="left_hip_roll_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_roll">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="left_hip_roll_motor">
      <mechanicalReduction>19.612</mechanicalReduction>
    </actuator>
    <!-- MyActuator RMD-X8-150 | control: EtherCAT mode 5 (PVT/MIT impedance): position target + kp/kd per cycle, PD on the driver -->
  </transmission>
  <transmission name="left_hip_yaw_transmission">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="left_hip_yaw">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>

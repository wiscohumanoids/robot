<?xml version="1.0"?>
<package format="3">
  <name>hsim_manipulation</name>
  <version>0.1.0</version>
  <description>Manipulation skill: runs the VLA policy (services/vla_server, GR00T) at 20 Hz on the arms while the robot stands. Action server /skills/manipulate.</description>
  <maintainer email="wiscohumanoids@gmail.com">WiscoHumanoids</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>hsim_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

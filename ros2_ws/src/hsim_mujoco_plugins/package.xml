<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hsim_mujoco_plugins</name>
  <version>0.1.0</version>
  <description>MuJoCo plugins for the sim stack's ros2_control backends: the world's ground-truth state (GroundTruthPlugin, for mujoco_ros2_control) and the robot's EtherCAT hardware simulated (VirtualRobotSystem, a hardware plugin: simulated CiA402 drives on MuJoCo)</description>
  <maintainer email="wiscohumanoids@gmail.com">WiscoHumanoids</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>mujoco_vendor</depend>
  <depend>mujoco_ros2_control_msgs</depend>
  <depend>mujoco_ros2_control_plugins</depend>
  <depend>pluginlib</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>
  <depend>wisco_ethercat_ros2_hw</depend>
  <depend>yaml-cpp</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

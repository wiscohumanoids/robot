<?xml version="1.0"?>
<package format="3">
  <name>hsim_perception</name>
  <version>0.1.0</version>
  <description>Perception: open-vocabulary detection client (Grounding DINO + SAM 2 server on the GPU VM), the line-of-sight stub (fallback), and the world model (object memory)</description>
  <maintainer email="sohamhomework@gmail.com">Soham</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

  <!--
    ================================================================
    CANONICAL JOINT ORDER (23 DOF): THE contract every message, node, and
    controller in this repo is written against. Index 0-22 below matches
    humanoid_interfaces/config/canonical_joint_order.yaml EXACTLY. If you
    add/reorder a joint here, update that file too, and every array-valued
    field in humanoid_interfaces (JointTargets, JointCommand,
    RobotState.joint_*, PolicyObservation.joint_*) shifts with it. See
    ARCHITECTURE.md.

     0 left_hip_pitch_joint        6  right_hip_pitch_joint     12 waist_yaw_joint
     1 left_hip_roll_joint         7  right_hip_roll_joint      13 left_shoulder_pitch_joint
     2 left_hip_yaw_joint          8  right_hip_yaw_joint       14 left_shoulder_roll_joint
     3 left_knee_joint             9  right_knee_joint          15 left_shoulder_yaw_joint
     4 left_ankle_pitch_joint     10  right_ankle_pitch_joint   16 left_elbow_joint
     5 left_ankle_roll_joint      11  right_ankle_roll_joint    17 left_wrist_roll_joint
                                                                 18 right_shoulder_pitch_joint
                                                                 19 right_shoulder_roll_joint
                                                                 20 right_shoulder_yaw_joint
                                                                 21 right_elbow_joint
                                                                 22 right_wrist_roll_joint

    NOTE on berkeley_humanoid reconciliation: berkeley_humanoid's G1Env trains a
    29-DOF policy (adds waist_roll + waist_pitch, and wrist_pitch + wrist_yaw per
    arm = 6 extra joints not present here). This repo's canonical hardware is the
    23-DOF G1 (waist yaw only, single-DOF wrists, rubber hands, no dexterous hand).
    berkeley_humanoid's G1Env already holds those 6 extra joints near-fixed with
    zero correction_scaling during walking, so dropping them is a safe truncation,
    not a retrain-from-scratch requirement: see INTEGRATION_POINTS.md
    "Locomotion" section for the exact 29 to 23 index mapping the locomotion_runner
    adapter must apply. That mapping lives in code (locomotion_runner's
    CANONICAL_TO_BERKELEY29), this comment just states the joint-order contract.

    INTERFACE CONTRACT (sim/hardware symmetry):
    Every joint exports command_interface "effort" (torque, Nm) and state
    interfaces "position" (rad), "velocity" (rad/s), "effort" (Nm, measured/applied
    torque). This is intentionally NOT the position_pid interface bipedal_nav
    originally used here (only mujoco_ros2_control's built-in PID understood it,
    and a real EtherCAT torque-mode drive has no equivalent). The position-tracking
    PID now lives one layer up, in lowlevel_control's JointImpedanceController
    (tau = tau_ff + Kp*(q_d-q) + Kd*(qd_d-qd)), which runs identically whether
    the plugin below resolves to mujoco_ros2_control/MujocoSystem (sim) or
    ethercat_bridge/EthercatHardwareInterface (real hardware). Confirmed by
    reading mujoco_system.cpp: its effort branch writes straight to qfrc_applied,
    clamped to this URDF's per-joint limit-effort attribute, with no actuator
    elements fighting it in g1_23dof_rev_1_0.xml (verified: zero actuator
    elements in that MJCF, timestep=0.001s, i.e. the sim's physics rate already
    matches our 1kHz control loop 1:1).
    ================================================================
  -->
  <ros2_control name="G1System" type="system">
    <hardware>
      <plugin>$(arg hardware_plugin)</plugin>
      <!-- Consumed only by ethercat_bridge/EthercatHardwareInterface (ignored by
           mujoco_ros2_control/MujocoSystem, which does not look up these keys).
           Relative slave-config path is resolved against ethercat_bridge's own
           ament_index share directory if it isn't absolute: see
           ethercat_bridge/README.md and RESEARCH_NOTES.md section 1. -->
      <param name="ethercat_slave_config">config/ethercat_slaves.yaml</param>
      <param name="ethercat_network_interface">eth0</param>
    </hardware>

    <!-- 0: left_hip_pitch_joint -->
    <joint name="left_hip_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 1: left_hip_roll_joint -->
    <joint name="left_hip_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 2: left_hip_yaw_joint -->
    <joint name="left_hip_yaw_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 3: left_knee_joint -->
    <joint name="left_knee_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.4</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 4: left_ankle_pitch_joint -->
    <joint name="left_ankle_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 5: left_ankle_roll_joint -->
    <joint name="left_ankle_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 6: right_hip_pitch_joint -->
    <joint name="right_hip_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 7: right_hip_roll_joint -->
    <joint name="right_hip_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 8: right_hip_yaw_joint -->
    <joint name="right_hip_yaw_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 9: right_knee_joint -->
    <joint name="right_knee_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.4</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 10: right_ankle_pitch_joint -->
    <joint name="right_ankle_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 11: right_ankle_roll_joint -->
    <joint name="right_ankle_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 12: waist_yaw_joint -->
    <joint name="waist_yaw_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 13: left_shoulder_pitch_joint -->
    <joint name="left_shoulder_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.3</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 14: left_shoulder_roll_joint -->
    <joint name="left_shoulder_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.15</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 15: left_shoulder_yaw_joint -->
    <joint name="left_shoulder_yaw_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 16: left_elbow_joint -->
    <joint name="left_elbow_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.5</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 17: left_wrist_roll_joint -->
    <joint name="left_wrist_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 18: right_shoulder_pitch_joint -->
    <joint name="right_shoulder_pitch_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.3</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 19: right_shoulder_roll_joint -->
    <joint name="right_shoulder_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">-0.15</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 20: right_shoulder_yaw_joint -->
    <joint name="right_shoulder_yaw_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 21: right_elbow_joint -->
    <joint name="right_elbow_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.5</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- 22: right_wrist_roll_joint -->
    <joint name="right_wrist_roll_joint">
      <command_interface name="effort"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Pelvis IMU. Sensor name MUST be "*_imu" and MUST resolve (by
         stripping the last "_"-segment) to a MuJoCo sensor name prefix that
         actually exists in g1_23dof_rev_1_0.xml: mujoco_system.cpp's
         register_sensors() looks up "prefix_quat"/"prefix_gyro"/
         "prefix_accel" by exact MuJoCo sensor name. "imu_imu" strips to
         prefix "imu", matching imu_quat/imu_gyro/imu_accel in the MJCF (the
         framequat one was renamed from imu_orientation to imu_quat for
         exactly this reason: see g1_23dof_rev_1_0.xml and README.md).
         State interface names below (orientation.x/y/z/w,
         angular_velocity.x/y/z, linear_acceleration.x/y/z) are the standard
         ros2_control IMU sensor interface convention. -->
    <sensor name="imu_imu">
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>
  </ros2_control>

</robot>
<?xml version="1.0"?>
<package format="3">
  <name>locomotion_runner</name>
  <version>0.1.0</version>
  <description>
    50 Hz locomotion node. Ships a stub sinusoidal/hold-pose gait behind the
    exact same interface a dropped-in berkeley_humanoid ONNX policy would
    use. See README.md and INTEGRATION_POINTS.md.
  </description>
  <maintainer email="wiscohumanoids@example.com">WiscoHumanoids</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>humanoid_interfaces</depend>
  <depend>ament_index_python</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

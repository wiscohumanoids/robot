<?xml version="1.0"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files that start the whole stack (every layer, stubs included) with
    per-layer stub|external switches, the config/controllers.yaml every
    controller_manager instance loads, and check_contract.py, the live
    interface-contract checker. See README.md and INTERFACE_CONTRACT.md.
  </description>
  <maintainer email="wiscohumanoids@example.com">WiscoHumanoids</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>g1_description</exec_depend>
  <exec_depend>mujoco_sim</exec_depend>
  <exec_depend>lowlevel_control</exec_depend>
  <exec_depend>ethercat_bridge</exec_depend>
  <exec_depend>teleop_input</exec_depend>
  <exec_depend>locomotion_runner</exec_depend>
  <exec_depend>manipulation_runner</exec_depend>
  <exec_depend>wbc_stub</exec_depend>
  <exec_depend>safety</exec_depend>
  <exec_depend>cmd_vel_mux</exec_depend>
  <exec_depend>task_planner_stub</exec_depend>
  <exec_depend>behavior_tree_stub</exec_depend>
  <exec_depend>perception_stub</exec_depend>
  <exec_depend>state_estimation_stub</exec_depend>
  <exec_depend>slam_stub</exec_depend>
  <exec_depend>nav_stub</exec_depend>
  <exec_depend>humanoid_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
